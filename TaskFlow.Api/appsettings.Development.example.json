    "Password": "your-mailtrap-password",
    "From": "noreply@taskflow.dev"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}